--- upstream
+++ personal
@@ -74,9 +74,17 @@
 
 wait_for_awww() {
-    local max=300 count=0
-    until awww query >/dev/null 2>&1; do
-        (( count++ ))
-        if (( count >= max )); then
-            error "awww-daemon did not start within 30s"
+    local deadline=$((SECONDS + 30)) outputs monitors
+    bash "$HOME/.config/ml4w/scripts/ml4w-start-wallpaper-daemon" || return 1
+    # The daemon can answer queries before it has registered the external LCD.
+    # Wait for every active Hyprland output, not just the daemon's socket.
+    until outputs=$(timeout 2s awww query -j 2>/dev/null) &&
+          monitors=$(timeout 2s hyprctl -j monitors 2>/dev/null) &&
+          jq -en --argjson outputs "$outputs" --argjson monitors "$monitors" '
+              [$outputs[][] | select(.width > 0 and .height > 0) | .name] as $ready
+              | [$monitors[] | select(.disabled != true) | .name] as $expected
+              | ($expected | length) > 0 and (($expected - $ready) | length) == 0
+          ' >/dev/null 2>&1; do
+        if (( SECONDS >= deadline )); then
+            error "awww-daemon did not become ready for all active displays within 30s"
             exit 1
         fi
