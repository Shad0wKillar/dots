 apply_effect
-wait_for_awww
-set_wallpaper
+if [ "$SKIP_WALLPAPER" != true ]; then
+    wait_for_awww || exit 1
+fi
+set_wallpaper || exit 1
 if "$SKIP_THEMING"; then
     info "Updating theming skipped"
