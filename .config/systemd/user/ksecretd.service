[Unit]
Description=Freedesktop Secret Service daemon (KDE ksecretd backend, backs Electron safeStorage / libsecret apps)
Documentation=man:ksecretd(1)

[Service]
ExecStart=/usr/bin/ksecretd
Restart=on-failure
RestartSec=2
StartLimitIntervalSec=0
Slice=session.slice

[Install]
WantedBy=default.target
