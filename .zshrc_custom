bindkey '^H' backward-kill-word
bindkey '^N' autosuggest-accept

# Skip history for commands typed with a leading space
setopt HIST_IGNORE_SPACE

# NVM
export NVM_DIR="$HOME/.nvm"

## I set up lazy loading to defer NVM initialization until a node command is run
zsh_defer_nvm() {
    unset -f node npm yarn nvm npx
    [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
    [ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"
}
node() { zsh_defer_nvm; node "$@" }
npm() { zsh_defer_nvm; npm "$@" }
yarn() { zsh_defer_nvm; yarn "$@" }
nvm() { zsh_defer_nvm; nvm "$@" }
npx() { zsh_defer_nvm; npx "$@" }
